# .env.example
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Required for the AI/LLM path:
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional -- cost governance (0 = unlimited):
# Maximum number of real Anthropic API calls per process lifetime.
# When exceeded, every subsequent request uses the rule-based fallback.
# Restart the process to reset the counter.
AI_MAX_REQUESTS=0

# Optional -- cache TTL in seconds (default: 300 = 5 minutes).
# Identical RepoAnalysis inputs within this window skip the LLM call.
# AI_CACHE_TTL_SECONDS=300

# CORS -- comma-separated frontend origins.
ALLOWED_ORIGINS=http://localhost:5173

# Render injects PORT automatically.
# PORT=8000
