# frontend/.env.example
# Copy this file to frontend/.env.local for local development.
# Never commit .env.local — it is listed in frontend/.gitignore.
#
# In production, set VITE_API_URL in the Vercel dashboard under
# Project → Settings → Environment Variables.
# Do NOT hardcode the Render URL here.
#
# Local development (backend running on default port):
VITE_API_URL=http://localhost:8000
#
# When VITE_API_URL is not set, the frontend uses built-in mock data
# so UI development works without a running backend.
